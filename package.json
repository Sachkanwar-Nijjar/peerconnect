    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.2.0",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prisma": "6.19.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "overrides": {
    "minimatch": "^11.0.1",
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0"
