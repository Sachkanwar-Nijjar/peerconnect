generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  STUDENT
  FACULTY
  MODERATOR
  ADMIN
}
enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role Role @default(STUDENT)
  requestedFaculty Boolean @default(false)
  verified Boolean @default(false)
  disabled Boolean @default(false)
  createdAt DateTime @default(now())
  profile Profile?
  learningCourses ProfileCourse[]
  helpOffers HelpOffer[]
  guidanceSent GuidanceRequest[] @relation("GuidanceSender")
  guidanceReceived GuidanceRequest[] @relation("GuidanceRecipient")
  guidanceMessages GuidanceMessage[]
  guidanceReviews GuidanceReview[]
  courseExperiences CourseExperience[]
  sessions Session[]
  tokens VerificationToken[]
  projects Project[]
  applications Application[]
  memberships TeamMembership[]
  conversationsA Conversation[] @relation("participantA")
  conversationsB Conversation[] @relation("participantB")
  messages Message[]
  notifications Notification[]
  posts CommunityPost[]
  likes PostLike[]
  comments PostComment[]
  reports PostReport[]
}
model Session {
  id String @id
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime
  @@index([userId])
}
model VerificationToken {
  id String @id
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  expiresAt DateTime
}
model Profile {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  department String @default("")
  year Int @default(1)
  bio String @default("")
  technologies String[]
  interests String[]
  experience String @default("")
  availability String @default("")
  github String @default("")
  linkedin String @default("")
  skills ProfileSkill[]
}
model Skill {
  id String @id @default(cuid())
  name String @unique
  profiles ProfileSkill[]
  projects ProjectRequiredSkill[]
}
model ProfileSkill {
  profileId String
  skillId String
  profile Profile @relation(fields:[profileId],references:[id],onDelete:Cascade)
  skill Skill @relation(fields:[skillId],references:[id],onDelete:Restrict)
  @@id([profileId,skillId])
}
model Project {
  id String @id @default(cuid())
  title String
  description String
  category String
  technologies String[]
  interests String[]
  teamSize Int
  status String @default("OPEN")
  creatorId String
  creator User @relation(fields:[creatorId],references:[id],onDelete:Restrict)
  createdAt DateTime @default(now())
  skills ProjectRequiredSkill[]
  research ResearchOpportunity?
  applications Application[]
  team Team?
  posts CommunityPost[]
  @@index([creatorId,status])
  @@index([createdAt])
}
model ResearchOpportunity {
  id String @id @default(cuid())
  projectId String @unique
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  department String
  details String @default("")
}
model ProjectRequiredSkill {
  projectId String
  skillId String
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  skill Skill @relation(fields:[skillId],references:[id],onDelete:Restrict)
  @@id([projectId,skillId])
}
model Application {
  id String @id @default(cuid())
  projectId String
  applicantId String
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  applicant User @relation(fields:[applicantId],references:[id],onDelete:Cascade)
  status ApplicationStatus @default(PENDING)
  note String @default("")
  createdAt DateTime @default(now())
  @@unique([projectId,applicantId])
  @@index([applicantId,status])
}
model Team {
  id String @id @default(cuid())
  projectId String @unique
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  members TeamMembership[]
}
model TeamMembership {
  teamId String
  userId String
  team Team @relation(fields:[teamId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  joinedAt DateTime @default(now())
  @@id([teamId,userId])
}
model Conversation {
  id String @id @default(cuid())
  aId String
  bId String
  a User @relation("participantA",fields:[aId],references:[id],onDelete:Cascade)
  b User @relation("participantB",fields:[bId],references:[id],onDelete:Cascade)
  messages Message[]
  @@unique([aId,bId])
}
model Message {
  id String @id @default(cuid())
  conversationId String
  conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade)
  senderId String
  sender User @relation(fields:[senderId],references:[id],onDelete:Cascade)
  content String
  read Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([conversationId,createdAt])
}
model Notification {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  text String
  href String
  read Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([userId,read,createdAt])
}
model CommunityPost {
  id String @id @default(cuid())
  authorId String
  author User @relation(fields:[authorId],references:[id],onDelete:Cascade)
  content String
  category String
  highlighted Boolean @default(false)
  hidden Boolean @default(false)
  projectId String?
  project Project? @relation(fields:[projectId],references:[id],onDelete:SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  likes PostLike[]
  comments PostComment[]
  reports PostReport[]
  @@index([hidden,createdAt])
}
model PostLike {
  postId String
  userId String
  post CommunityPost @relation(fields:[postId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@id([postId,userId])
}
model PostComment {
  id String @id @default(cuid())
  postId String
  authorId String
  post CommunityPost @relation(fields:[postId],references:[id],onDelete:Cascade)
  author User @relation(fields:[authorId],references:[id],onDelete:Cascade)
  content String
  createdAt DateTime @default(now())
  @@index([postId,createdAt])
}
model PostReport {
  id String @id @default(cuid())
  postId String
  reporterId String
  post CommunityPost @relation(fields:[postId],references:[id],onDelete:Cascade)
  reporter User @relation(fields:[reporterId],references:[id],onDelete:Cascade)
  reason String
  resolved Boolean @default(false)
  createdAt DateTime @default(now())
  @@unique([postId,reporterId])
}

model Course {
 code String @id
 title String
 branch String
 semester Int
 credits Float
 sourceUrl String
 scheme String
 checkedAt String
 students ProfileCourse[]
 requests GuidanceRequest[]
 experiences CourseExperience[]
}
model ProfileCourse {
 userId String
 courseCode String
 status String
 available Boolean @default(false)
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 course Course @relation(fields:[courseCode],references:[code],onDelete:Cascade)
 @@id([userId,courseCode])
}
model HelpOffer {
 id String @id @default(cuid())
 userId String
 skill String
 category String
 level String
 available Boolean @default(true)
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@unique([userId,skill])
 @@index([skill,available])
}
model GuidanceRequest {
 id String @id @default(cuid())
 senderId String
 recipientId String
 topic String
 courseCode String?
 skill String?
 question String
 status String @default("PENDING")
 activeKey String? @unique
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 sender User @relation("GuidanceSender",fields:[senderId],references:[id],onDelete:Cascade)
 recipient User @relation("GuidanceRecipient",fields:[recipientId],references:[id],onDelete:Cascade)
 course Course? @relation(fields:[courseCode],references:[code],onDelete:SetNull)
 messages GuidanceMessage[]
 reviews GuidanceReview[]
 @@index([senderId,status,createdAt])
 @@index([recipientId,status,createdAt])
}
model GuidanceMessage {
 id String @id @default(cuid())
 requestId String
 senderId String
 content String
 createdAt DateTime @default(now())
 request GuidanceRequest @relation(fields:[requestId],references:[id],onDelete:Cascade)
 sender User @relation(fields:[senderId],references:[id],onDelete:Cascade)
 @@index([requestId,createdAt])
}
model GuidanceReview {
 id String @id @default(cuid())
 requestId String
 authorId String
 rating Int
 createdAt DateTime @default(now())
 request GuidanceRequest @relation(fields:[requestId],references:[id],onDelete:Cascade)
 author User @relation(fields:[authorId],references:[id],onDelete:Cascade)
 @@unique([requestId,authorId])
}
model CourseExperience {
 userId String
 courseCode String
 workload Int
 advice String
 cohort String
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 course Course @relation(fields:[courseCode],references:[code],onDelete:Cascade)
 @@id([userId,courseCode])
}
