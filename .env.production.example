# Copy as .env.production.local on a managed Next.js host, or inject as container secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/peerconnect?schema=public&sslmode=require
APP_URL=https://YOUR-DOMAIN
UNIVERSITY_DOMAINS=thapar.edu
DEV_EMAIL_VERIFICATION=false
SESSION_SECURE=true
SMTP_URL=smtps://USER:PASSWORD@SMTP-HOST:465
EMAIL_FROM=PeerConnect <YOUR-VERIFIED-SENDER>
NEXT_TELEMETRY_DISABLED=1
